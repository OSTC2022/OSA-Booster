# =============================================================================
# Production Worker secrets (values NEVER committed)
# =============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GARMIN_TOKEN_ENCRYPTION_KEY=

# Emergency stop: false = heartbeat continues, Garmin API calls stop
GARMIN_SYNC_ENABLED=true
GARMIN_BETA_ENABLED=true

# Scheduler (conservative unofficial integration defaults — not a Garmin SLA)
GARMIN_WORKER_TICK_SECONDS=60
GARMIN_SYNC_INTERVAL_MINUTES=120
GARMIN_SYNC_MEMBER_DELAY_SECONDS=5
GARMIN_SYNC_MEMBER_DELAY_JITTER_SECONDS=3
GARMIN_INCREMENTAL_LOOKBACK_DAYS=3
GARMIN_INITIAL_IMPORT_MAX_DAYS=62
GARMIN_MANUAL_SYNC_COOLDOWN_MINUTES=5
GARMIN_RATE_LIMIT_COOLDOWN_MINUTES=120
GARMIN_MAX_MEMBERS_PER_TICK=3
GARMIN_BACKOFF_BASE_MINUTES=15
GARMIN_BACKOFF_MAX_MINUTES=360

# =============================================================================
# Dev / connector only (NOT used by production python -m app.worker)
# =============================================================================
# GARMIN_EMAIL=
# GARMIN_PASSWORD=
# GARMIN_TOKEN_DIR=./data/tokens
# GARMIN_LOOKBACK_DAYS=7
# GARMIN_DRY_RUN=true
# ONE_STEP_API_BASE=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=
# GARMIN_TEST_MEMBER_ID=
