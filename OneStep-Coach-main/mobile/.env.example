# Public only — never put SERVICE_ROLE / encryption keys here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
EXPO_PUBLIC_WEB_PORTAL_URL=https://your-onestep-web.example
